<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vista_from_iva_retention_prove_fact_dig" model="ir.ui.view">
        <field name="name">vista.from.iva.retention.prove.fact.dig</field>
        <field name="model">vat.retention</field>
        <field name="inherit_id" ref="iva_retention.vista_from_iva_retention_clien"/>
        <field name="arch" type="xml">

            <xpath expr="/form//button[@name='comprobante']" position="after">
                <button name="comprobante_sv" string="Imprimir Comprobante" class="btn-success" type="object" invisible="state!='sent'"/>
            </xpath>

            <xpath expr="/form//button[@name='comprobante']" position="attributes">
                <attribute name="invisible">state in ('draft','sent') or type in ('out_invoice','out_refund','out_receipt')</attribute>
            </xpath>

            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,posted,sent,cancel</attribute>
            </xpath>

            <xpath expr="/form/sheet/notebook/page" position="after">
                <page string="Respuesta json " name="studio_page_1s6_1juo5h96h">
                  <group name="studio_group_1s6">
                    <group name="studio_group_1s6_left">
                        <field name="result" readonly="state!='draft'"/>
                        <field name="hasErrors" string="Hubo Error?" readonly="state!='draft'"/>
                        <field name="information" string="Informacion:" readonly="state!='draft'"/>
                        <field name="message" string="Mensaje del api" readonly="state!='draft'"/>
                    </group>
                    <group name="studio_group_1s6_right">
                        <field name="errorMessage" string="Mensaje de error" readonly="state!='draft'"/>
                        <field name="code" readonly="state!='draft'" class="fw-bold" decoration-success="code == '200'" decoration-danger="code and code != '200'"/>
                        <field name="json_enviado" readonly="state!='draft'"/>
                    </group>
                  </group>
                </page>
            </xpath>


            <xpath expr="/form//button[@name='comprobante']" position="after">
                <button name="envia_comp_ret_iva" string="Enviar o Sincronizar" type="object" invisible="state!='posted'"/>
                <!--button name="envia_comp_ret_iva" string="Enviar o Sincronizar" type="object" /-->
            </xpath>

        </field>
    </record>
</odoo>