<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        

        <record id="account_inherit_view_form_fd" model="ir.ui.view">
            <field name="name">account.inherit.view.form.fd</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="/form//field[@name='observacion']" position="after">
                  
                  <field name="usar_fact_digi" invisible="1"/>
                  <field name="information" invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt') or not usar_fact_digi" readonly="state!='draft'"/>

                  <field name="proximo_doc" 
                   string="Nro Doc. Disponible" 
                   invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt') or not usar_fact_digi or state != 'draft'"/>

                  <field name="proximo_ctrl" 
                   string="Nro Ctrl disponible" 
                   invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt') or not usar_fact_digi or state != 'draft'"/>

                  <field name="code" invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt') or not usar_fact_digi" readonly="state!='draft'" class="fw-bold" decoration-success="code == '200'" decoration-danger="code and code != '200'"/>
                  
                </xpath>

                <xpath expr="/form//page[@id='other_tab_entry']" position="after">
                  <page string="Inf. Respuesta api Fact. Digital" name="studio_page_4pi_1jugr83qd" invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt') or not usar_fact_digi">
                    <group name="studio_group_4pi">
                      <group name="studio_group_4pi_left">
                        <field name="result" readonly="state!='draft'"/>
                        <field name="hasErrors" string="Hubo Error?" readonly="state!='draft'"/>
                        <field name="errorMessage" string="Mensaje de error" readonly="state!='draft'"/>
                        <field name="information" string="Informacion:" readonly="state!='draft'"/>
                        <field name="code" readonly="state!='draft'" class="fw-bold" decoration-success="code == '200'" decoration-danger="code and code != '200'"/>
                      </group>
                      <group name="studio_group_4pi_right">
                        <field name="json_enviado" readonly="state!='draft'"/>
                      </group>
                    </group>
                  </page>
                </xpath>

                <!--xpath expr="//form[1]/sheet[1]/notebook[1]" position="inside">
                  <page string="Resp Json Fact. Dig." name="studio_page_TtooT">
                    <group name="studio_group_TtooT">
                      <group name="studio_group_TtooT_left">
                        <field name="validaciones"/>
                        <field name="codigo"/>
                        <field name="mensaje"/>
                      </group>
                      <group name="studio_group_TtooT_right">
                        <field name="token"/>
                        <field name="resultado"/>
                        <field name="urlConsulta" string="URL Factura" widget="url"/>
                      </group>
                    </group>
                  </page>
                </xpath-->

                <xpath expr="/form//button[@name='formato_libre']" position="attributes">
                  <attribute name="invisible">move_type in ('in_invoice', 'in_refund','in_receipt') or state =='draft' or usar_fact_digi==True</attribute>
                </xpath>

                <xpath expr="/form/header/button[@name='action_post'][2]" position="attributes">
                    <attribute name="invisible">hide_post_button or move_type == 'entry' or display_inactive_currency_warning or (usar_fact_digi and move_type in ('out_invoice', 'out_refund', 'out_receipt'))</attribute>
                </xpath>

                <xpath expr="//button[@id='account_invoice_payment_btn']" position="after">
                         <!--button name="enviar_fact_digital" string="simular envio" type="object" /-->

                  <button name="confirmar2" 
                    string="Confirmar" 
                    type="object" 
                    class="btn-success"
                    invisible="not usar_fact_digi or move_type not in ('out_invoice', 'out_refund', 'out_receipt') or state!='draft'"/>

                  <button name="print_digital" string="Imprimir Fact/NC/ND" class="btn-success" type="object" invisible="state!='posted' or usar_fact_digi!=True"/>
                         
                         <!--button name="button_draft" string="borrador 2" type="object" /-->
                </xpath>


            </field>
        </record>

    </data>
</odoo>