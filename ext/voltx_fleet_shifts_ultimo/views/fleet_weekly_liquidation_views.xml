<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Vista Lista -->
    <record id="fleet_weekly_liquidation_view_list" model="ir.ui.view">
        <field name="name">fleet.weekly.liquidation.list</field>
        <field name="model">fleet.weekly.liquidation</field>
        <field name="arch" type="xml">
            <list string="Liquidaciones Semanales">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="driver_id"/>
                <field name="week_of_year"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="bs_currency_id" column_invisible="1"/>
                <field name="amount_total_usd" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="amount_total_bs" widget="monetary" options="{'currency_field': 'bs_currency_id'}"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'invoiced'"
                       decoration-success="state == 'paid'"/>
            </list>
        </field>
    </record>

    <!-- 2. Vista Formulario -->
    <record id="fleet_weekly_liquidation_view_form" model="ir.ui.view">
        <field name="name">fleet.weekly.liquidation.form</field>
        <field name="model">fleet.weekly.liquidation</field>
        <field name="arch" type="xml">
            <form string="Liquidación Semanal">
                <header>
                    <button name="action_generate_invoice" string="Generar Factura" type="object" class="oe_highlight" invisible="invoice_id != False"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,invoiced,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="driver_id"/>
                            <field name="week_of_year"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="bs_currency_id" invisible="1"/>
                            <field name="amount_total_usd" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="amount_total_bs" widget="monetary" options="{'currency_field': 'bs_currency_id'}"/>
                            <field name="invoice_id" invisible="invoice_id == False"/>
                        </group>
                    </group>
                    <group string="Detalles / Factura">
                        <field name="observation" nolabel="1" placeholder="Indicar observaciones de la semana o notas del pago..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 3. Acción de Ventana para el Menú -->
    <record id="action_fleet_weekly_liquidation" model="ir.actions.act_window">
        <field name="name">Liquidaciones Semanales</field>
        <field name="res_model">fleet.weekly.liquidation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree una nueva liquidación semanal.
            </p>
        </field>
    </record>
</odoo>