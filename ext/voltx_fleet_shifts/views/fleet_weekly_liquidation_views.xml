<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_weekly_liquidation_view_form" model="ir.ui.view">
        <field name="name">fleet.weekly.liquidation.form</field>
        <field name="model">fleet.weekly.liquidation</field>
        <field name="arch" type="xml">
            <form string="Liquidación Semanal">
                <header>
                    <button name="action_generate_invoice" string="Generar Factura" type="object" class="oe_highlight" invisible="invoice_id != False"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,invoiced,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="driver_id"/>
                            <field name="week_of_year"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="bs_currency_id" invisible="1"/>
                            <field name="amount_total_usd" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="amount_total_bs" widget="monetary" options="{'currency_field': 'bs_currency_id'}"/>
                            <field name="invoice_id" invisible="invoice_id == False"/>
                        </group>
                    </group>
                    <group string="Detalles / Factura">
                        <field name="observation" nolabel="1" placeholder="Indicar observaciones de la semana o notas del pago..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>