<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit fleet.vehicle.log.contract form view -->
    <record id="view_fleet_vehicle_log_contract_form_inherit_shifts" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.contract.form.inherit.shifts</field>
        <field name="model">fleet.vehicle.log.contract</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_contract_view_form"/>
        <field name="arch" type="xml">

            <!-- 0. Botones de acción en el header -->
            <!--xpath expr="//header" position="inside">
                <button name="action_start_daily_shift" string="Check-in (Iniciar Turno)" type="object" class="oe_highlight" icon="fa-play"/>
                <button name="action_end_daily_shift" string="Check-out (Finalizar Turno)" type="object" class="btn-secondary" icon="fa-stop"/>
            </xpath-->

            <!-- 1. Smart Buttons en el Button Box oficial -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_daily_logs" type="object" class="oe_stat_button" icon="fa-calendar">
                        <field name="daily_logs_count" widget="statinfo" string="Registros diarios"/>
                    </button>
                    <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                        <field name="invoice_count" widget="statinfo" string="Facturas"/>
                    </button>
                </div>
            </xpath>

            <!-- 2. Campo Turno al lado del seguro/conductor -->
            <xpath expr="//field[@name='insurer_id']" position="after">
                <field name="shift_id"/>
                <field name="secondary_currency_id" invisible="1"/>
                <field name="vehicle_driver_ids" invisible="1"/>
            </xpath>

            <!-- Restringir la selección de conductor (purchaser_id) a aquellos asignados en el vehículo -->


            <xpath expr="//field[@name='purchaser_id']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="readonly">0</attribute>
                <attribute name="domain">[('id', 'in', vehicle_driver_ids)]</attribute>
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

            <!-- 2.5 Modificar campos amount y cost_generated (si existe en Odoo base) para forzar moneda -->
            <!-- Usamos un xpath flexible que no crasheará si el campo cost_generate no existe -->
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="widget">monetary</attribute>
                <attribute name="options">{'currency_field': 'secondary_currency_id'}</attribute>
            </xpath>

            <xpath expr="//field[@name='cost_generated']" position="attributes">
                <attribute name="widget">monetary</attribute>
                <attribute name="options">{'currency_field': 'secondary_currency_id'}</attribute>
            </xpath>

            <!-- Agregar campo cost_generate si no está en la vista para asegurar que el modelo lo registre -->
            <!--xpath expr="//field[@name='amount']" position="after">
                <field name="cost_generate" widget="monetary" options="{'currency_field': 'secondary_currency_id'}" invisible="1"/>
            </xpath-->

            <!-- 3. Notebook con las Liquidaciones Semanales al final de la ficha -->
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Liquidaciones semanales" name="weekly_liquidations">
                        <field name="liquidation_ids">
                            <list editable="bottom" decoration-info="state == 'draft'" decoration-success="state == 'paid'">
                                <field name="currency_id" column_invisible="1"/>
                                <field name="week_of_year"/>
                                <field name="days_worked" readonly="1"/>
                                <field name="total_hours" widget="float_time" readonly="1"/>
                                <field name="amount_total" readonly="1"/>
                                <field name="amount_total_bs" readonly="1"/>
                                <field name="amount_total_usd" readonly="1"/>

                                <field name="invoice_id" readonly="1"/>
                                <field name="state" widget="badge"/>
                                <button name="action_generate_invoice" 
                                        type="object" 
                                        string="Liquidar y Facturar" 
                                        class="btn-primary" 
                                        invisible="invoice_id"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>

        </field>
    </record>

</odoo>