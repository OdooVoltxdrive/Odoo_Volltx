<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit fleet.vehicle form view to add Driver Tags -->
    <record id="view_fleet_vehicle_form_inherit_shifts" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.shifts</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">

            <!-- Replace standard driver fields to make them readonly and add our tags -->
            <xpath expr="//field[@name='driver_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <xpath expr="//field[@name='future_driver_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <xpath expr="//field[@name='future_driver_id']" position="after">
                <field name="driver_ids" widget="many2many_tags" string="Conductores asignados"/>
            </xpath>

        </field>
    </record>

</odoo>
