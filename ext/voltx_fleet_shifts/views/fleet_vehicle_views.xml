<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit fleet.vehicle form view to add Driver Slots -->
    <record id="view_fleet_vehicle_form_inherit_shifts" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.shifts</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Driver Slots" name="driver_slots">
                    <field name="driver_slot_ids">
                        <tree editable="bottom">
                            <field name="driver_id"/>
                            <field name="shift_id"/>
                            <field name="contract_id"/>
                            <field name="is_active_shift" readonly="1" decoration-success="is_active_shift == True" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
