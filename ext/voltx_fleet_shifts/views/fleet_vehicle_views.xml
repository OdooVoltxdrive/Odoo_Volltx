<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fleet_vehicle_form_inherit_shifts" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.shifts</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">

            <!-- Asegurar que el campo se ubique justo después de Próximo conductor -->
            <xpath expr="//field[@name='future_driver_id']" position="after">
                <field name="driver_ids" 
                       widget="many2many_tags" 
                       domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                       placeholder="Seleccione los conductores autorizados..."/>
            </xpath>

        </field>
    </record>

</odoo>