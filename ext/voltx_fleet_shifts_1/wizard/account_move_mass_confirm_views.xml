<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista del Wizard -->
    <record id="view_account_move_mass_confirm_form" model="ir.ui.view">
        <field name="name">account.move.mass.confirm.form</field>
        <field name="model">account.move.mass.confirm</field>
        <field name="arch" type="xml">
            <form string="Confirmación Masiva de Facturas">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="partner_id"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm_invoices" string="Confirmar Facturas" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción del Wizard (Menú general o botón) -->
    <record id="action_account_move_mass_confirm" model="ir.actions.act_window">
        <field name="name">Confirmar Facturas Masivamente</field>
        <field name="res_model">account.move.mass.confirm</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
    </record>

    <!-- Menú en Contabilidad para llamar al asistente sin selección -->
    <menuitem id="menu_account_move_mass_confirm"
              name="Confirmación Masiva"
              parent="account.menu_finance_entries"
              action="action_account_move_mass_confirm"
              sequence="25"/>
</odoo>
