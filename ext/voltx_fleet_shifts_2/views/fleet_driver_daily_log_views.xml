<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sequence for Daily Log -->
    <data noupdate="1">
        <record id="seq_fleet_driver_daily_log" model="ir.sequence">
            <field name="name">Daily Log</field>
            <field name="code">fleet.driver.daily.log</field>
            <field name="prefix">LOG/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <!-- Form View -->
    <record id="view_fleet_driver_daily_log_form" model="ir.ui.view">
        <field name="name">fleet.driver.daily.log.form</field>
        <field name="model">fleet.driver.daily.log</field>
        <field name="arch" type="xml">
            <form string="Daily Log">
                <header>
                    <button name="action_start_shift" type="object" string="Iniciar turno" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_end_shift" type="object" string="Finalizar turno" class="oe_highlight" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,done,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Referencia"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Asignación">
                            <field name="contract_id"/>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="shift_id"/>
                        </group>
                        <group string="Jornada y Horas">
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="hours_worked" readonly="1" widget="float_time"/>
                            <field name="worked" widget="boolean_toggle"/>
                            <field name="week_of_year" readonly="1"/>
                            <field name="liquidation_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_fleet_driver_daily_log_list" model="ir.ui.view">
        <field name="name">fleet.driver.daily.log.list</field>
        <field name="model">fleet.driver.daily.log</field>
        <field name="arch" type="xml">
            <list string="Daily Logs" decoration-success="worked" decoration-danger="not worked and state == 'done'">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="shift_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="hours_worked" widget="float_time"/>
                <field name="worked"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="view_fleet_driver_daily_log_calendar" model="ir.ui.view">
        <field name="name">fleet.driver.daily.log.calendar</field>
        <field name="model">fleet.driver.daily.log</field>
        <field name="arch" type="xml">
            <calendar string="Registros diarios" date_start="check_in" date_stop="check_out" color="driver_id">
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="hours_worked"/>
            </calendar>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_fleet_driver_daily_log_pivot" model="ir.ui.view">
        <field name="name">fleet.driver.daily.log.pivot</field>
        <field name="model">fleet.driver.daily.log</field>
        <field name="arch" type="xml">
            <pivot string="Daily Logs">
                <field name="driver_id" type="row"/>
                <field name="week_of_year" type="col"/>
                <field name="hours_worked" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_fleet_driver_daily_log_kanban" model="ir.ui.view">
        <field name="name">fleet.driver.daily.log.kanban</field>
        <field name="model">fleet.driver.daily.log</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="shift_id"/>
                <field name="hours_worked"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                            <div class="ribbon ribbon-top-right" invisible="state != 'paid'">
                                <span class="text-bg-success">Paid</span>
                            </div>
                            <div class="ribbon ribbon-top-right" invisible="state != 'done'">
                                <span class="text-bg-info">Done</span>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="text-muted mb-2">
                                    <i class="fa fa-car" title="Vehicle"/> <field name="vehicle_id"/>
                                </div>
                                <div>
                                    <i class="fa fa-user" title="Driver"/> <strong><field name="driver_id"/></strong>
                                </div>
                                <div invisible="not shift_id">
                                    <i class="fa fa-clock-o" title="Shift"/> <field name="shift_id"/>
                                </div>
                                <div class="mt-2 text-end">
                                    <span class="badge rounded-pill text-bg-secondary"><field name="hours_worked" widget="float_time"/> Hrs</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_fleet_driver_daily_log" model="ir.actions.act_window">
        <field name="name">Daily Logs</field>
        <field name="res_model">fleet.driver.daily.log</field>
        <field name="view_mode">list,kanban,calendar,pivot,form</field>
    </record>

</odoo>