<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_fleet_work_shift_form" model="ir.ui.view">
        <field name="name">fleet.work.shift.form</field>
        <field name="model">fleet.work.shift</field>
        <field name="arch" type="xml">
            <form string="Turnos de trabajo">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    
                    <div class="oe_title">
                        <label for="name" string="Nombre del Turno"/>
                        <h1>
                            <field name="name" placeholder="Ej. Diurno AM / Mixto Fin de Semana"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Configuración">
                            <field name="shift_type"/>
                            <field name="applies_on"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Horarios">
                            <field name="start_hour" widget="float_time"/>
                            <field name="end_hour" widget="float_time"/>
                            <field name="hours_per_day" widget="float_time" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_fleet_work_shift_tree" model="ir.ui.view">
        <field name="name">fleet.work.shift.list</field>
        <field name="model">fleet.work.shift</field>
        <field name="arch" type="xml">
            <list string="Turnos de trabajo">
                <field name="name"/>
                <field name="shift_type"/>
                <field name="applies_on"/>
                <field name="start_hour" widget="float_time"/>
                <field name="end_hour" widget="float_time"/>
                <field name="hours_per_day" widget="float_time"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_fleet_work_shift" model="ir.actions.act_window">
        <field name="name">Turnos de trabajo</field>
        <field name="res_model">fleet.work.shift</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer turno de trabajo
            </p>
            <p>
                Define horarios matutinos, vespertinos o jornadas mixtas de 12 horas para asignar a los contratos de flota.
            </p>
        </field>
    </record>

</odoo>