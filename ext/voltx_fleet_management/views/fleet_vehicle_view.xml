<?xml version="1.0" encoding="utf-8" ?>
<odoo>
     <!-- Inherited vehicle registration form view added extra fields on fleet vehicle -->
    <record id='fleet_vehicle_model_form_inherit_management' model='ir.ui.view'>
        <field name="name">fleet.vehicle.model.form.inherit</field>
        <field name="model">fleet.vehicle</field>
        <field eval="100" name="priority" />
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form" />
        <field name="arch" type="xml">
          

        <!-- Cambiar la etiqueta del campo nativo -->
        <xpath expr="//field[@name='driver_id']" position="attributes">
                <attribute name="string">Conductor actual</attribute>
        </xpath>

       <xpath expr="//field[@name='driver_id']" position="before">
                <field 
                    name="driver_slot_ids" 
                    widget="many2many_tags_avatar" 
                    placeholder="Seleccionar conductores..."
                    options="{'no_create_edit': True}"
                />
        </xpath>

        </field>
    </record>

</odoo>
