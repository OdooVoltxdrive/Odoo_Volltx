<?xml version="1.0" encoding="utf-8" ?>
<odoo>
     <!-- Inherited vehicle registration form view added extra fields on fleet vehicle -->
    <record id='fleet_vehicle_log_contract_form_inherit' model='ir.ui.view'>
        <field name="name">fleet.vehicle.log.form.inherit</field>
        <field name="model">fleet.vehicle.log.contract</field>
        <field eval="100" name="priority" />
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_contract_view_form" />
        <field name="arch" type="xml">

        <xpath expr="//header" position="inside">
            <button name="action_generar_plan_cuotas" 
                    string="Generar Plan de Cuotas" 
                    type="object" 
                    class="oe_highlight"
                    invisible="total_cuotas == 0 or precio_cuota == 0"/>
           <button name="action_ver_facturas"
                    string="Ver Facturas"
                    type="object"
                    invisible="not invoice_ids"/>
        </xpath>
          

          <xpath expr="//field[@name='date']/.." position="after">
                <group >
                    <field name="total_cuotas" string="Cantidad de Cuotas"/>
                    <field name="precio_cuota" string="Monto de la Cuota ($)" widget="monetary" options="{'currency_field': 'currency_usd_id'}"/>
                    <field name="monto_total_contrato" string="Monto Total Contrato" widget="monetary" options="{'currency_field': 'currency_usd_id'}" readonly="1"/>
                    <field name="currency_usd_id" invisible="1"/>
                    <field name="tasa_cambio" string="Tasa de Cambio (Bs por $)" readonly="1"/>
                </group>
            </xpath>

        <xpath expr="//sheet" position="inside">
            <notebook>
                <page string="Trazabilidad de Cuotas" name="plan_cuotas">
                    <field name="contract_line_ids" readonly="1">
                        <list decoration-success="state == 'paid'" 
                              decoration-danger="state == 'overdue'" 
                              decoration-warning="state == 'posted'" 
                              decoration-muted="state == 'draft'">
                            <field name="numero_cuota"/>
                            <field name="fecha_vencimiento"/>
                            <field name="monto" sum="Total Plan"/>
                            <field name="invoice_ids" widget="many2many_tags" string="Factura Odoo"/>
                            <field name="state" widget="badge" 
                                   decoration-success="state == 'paid'" 
                                   decoration-danger="state == 'overdue'" 
                                   decoration-warning="state == 'posted'"/>
                        </list>
                    </field>

                    <group class="oe_subtotal_footer">
                        <field name="tasa_cambio" string="Tasa de Cambio (Bs por $)" readonly="1"/>
                        <field name="invoice_ids" widget="many2many_tags" string="Facturas" placeholder="Facturas del contrato"/>
                    </group>
                </page>
            </notebook>
        </xpath> 
      
        </field>
    </record>
</odoo>
