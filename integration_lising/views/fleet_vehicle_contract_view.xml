<?xml version="1.0" encoding="utf-8" ?>
<odoo>
     <!-- Inherited vehicle registration form view added extra fields on fleet vehicle -->
    <record id='fleet_vehicle_log_contract_form_inherit' model='ir.ui.view'>
        <field name="name">fleet.vehicle.log.form.inherit</field>
        <field name="model">fleet.vehicle.log.contract</field>
        <field eval="100" name="priority" />
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_contract_view_form" />
        <field name="arch" type="xml">
          

          <xpath expr="//field[@name='date']/.." position="after">
                <group >
                    <field name="total_cuotas" string="Cantidad de Cuotas"/>
                    <field name="precio_cuota" string="Monto de la Cuota ($)" widget="monetary"/>
                    <field name="monto_total_contrato" string="Monto Total Contrato" widget="monetary" readonly="1"/>
                </group>
            </xpath>

        <xpath expr="//sheet" position="inside">
            <notebook>
                <page string="Trazabilidad de Cuotas" name="plan_cuotas">
                    <field name="contract_line_ids" readonly="1">
                        <list decoration-success="state == 'paid'" 
                              decoration-danger="state == 'overdue'" 
                              decoration-warning="state == 'posted'" 
                              decoration-muted="state == 'draft'">
                            <field name="numero_cuota"/>
                            <field name="fecha_vencimiento"/>
                            <field name="monto" sum="Total Plan"/>
                            <field name="invoice_id" string="Factura Odoo"/>
                            <field name="state" widget="badge" 
                                   decoration-success="state == 'paid'" 
                                   decoration-danger="state == 'overdue'" 
                                   decoration-warning="state == 'posted'"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </xpath>
          
      
        </field>
    </record>
</odoo>
