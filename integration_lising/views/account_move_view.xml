<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Bloque "Cobrado en Bs" en la factura: los Bs exactos del comprobante
         (los escribe el backend al crear el borrador). Solo visible en facturas
         de cliente ligadas a un canon del plan de leasing. -->
    <record id='account_move_form_bs_voltx' model='ir.ui.view'>
        <field name="name">account.move.form.bs.voltx</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Botón administrativo: transforma el borrador entre Bs y USD
                 (Efectivo agrega IGTF 3% al total al pasar a USD). -->
            <xpath expr="//header" position="inside">
                <button name="action_transformar_moneda" type="object"
                        string="Transformar a USD"
                        invisible="state != 'draft' or not contract_line_id or currency_id != company_currency_id"/>
                <button name="action_transformar_moneda" type="object"
                        string="Transformar a USD (Efectivo +3% IGTF)"
                        context="{'efectivo': True}"
                        invisible="state != 'draft' or not contract_line_id or currency_id != company_currency_id"/>
                <button name="action_transformar_moneda" type="object"
                        string="Transformar a Bs"
                        invisible="state != 'draft' or not contract_line_id or currency_id == company_currency_id"/>
            </xpath>
            <!-- El grupo original oe_subtotal_footer es reemplazado por la vista
                 de localizacion contable (footer IGTF); anclamos a la página
                 nativa de líneas, que nadie modifica. -->
            <xpath expr="//page[@id='invoice_tab']" position="inside">
                <group class="oe_subtotal_footer" string="Cobrado en Bs" invisible="not contract_line_id">
                    <field name="contract_line_id" invisible="1"/>
                    <field name="monto_bs" string="Canon exacto (Bs)" readonly="1"/>
                    <field name="servicio_bs" string="Cargo por servicios (Bs)" readonly="1"/>
                    <field name="total_bs" string="Total cobrado (Bs)" readonly="1" class="oe_subtotal_footer_separator"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
